rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }

    function isValidMessage(data) {
      return data.keys().hasAll(['first_name', 'user_email', 'message', 'createdAt'])
        && data.keys().hasOnly(['first_name', 'last_name', 'user_email', 'message', 'createdAt'])
        && data.first_name is string && data.first_name.size() > 0 && data.first_name.size() <= 100
        && (data.keys().hasAny(['last_name']) ? (data.last_name is string && data.last_name.size() <= 100) : true)
        && data.user_email is string && data.user_email.size() > 0 && data.user_email.size() <= 200 && data.user_email.matches('^[^@]+@[^@]+\\.[a-zA-Z]{2,}$')
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && data.createdAt == request.time;
    }

    match /messages/{messageId} {
      allow read, update, delete: if false;
      allow create: if isValidId(messageId) && isValidMessage(incoming());
    }
  }
}
